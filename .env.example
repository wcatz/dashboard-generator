# Dashboard Generator Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Phase 2: AI Integration (Claude API)
# ============================================
# Get your API key from: https://console.anthropic.com/
# Required for AI panel generation features
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: Override default model (default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ============================================
# Grafana Integration (Optional)
# ============================================
# If you want to push dashboards directly to Grafana
GRAFANA_URL=http://localhost:3000
# GRAFANA_TOKEN=your-grafana-api-token
# Or use basic auth:
# GRAFANA_USER=admin
# GRAFANA_PASS=admin

# ============================================
# Server Configuration
# ============================================
PORT=8080

# ============================================
# Development
# ============================================
# GO_ENV=development
# DEBUG=true
