# Dashboard Generator Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Phase 2: AI Integration (Claude API)
# ============================================
# Get your API key from: https://console.anthropic.com/
# Required for AI panel generation features
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: Override default model (default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ============================================
# Grafana Integration (Optional)
# ============================================
# Used for: dashboard push, live preview (iframe), panel import
#
# GRAFANA_URL — your Grafana instance URL
# GRAFANA_TOKEN — service account token with Editor role
#   Create at: Grafana → Administration → Service Accounts → Add token
#
# Or use basic auth instead of a token:
# GRAFANA_USER=admin
# GRAFANA_PASS=admin
#
# ── Live Preview Prerequisites ──
# Live preview embeds Grafana panels in an iframe. Your grafana.ini must have:
#
#   [security]
#   allow_embedding = true
#
#   [auth.anonymous]
#   enabled = true
#   org_role = Viewer
#
# Without allow_embedding, the iframe will be blank.
# Without anonymous auth, the iframe will show a login screen.
# Anonymous access is read-only (Viewer role) — no write risk.
#
GRAFANA_URL=http://localhost:3000
# GRAFANA_TOKEN=glsa_your-service-account-token-here

# ============================================
# Server Configuration
# ============================================
PORT=8080

# ============================================
# Development
# ============================================
# GO_ENV=development
# DEBUG=true
